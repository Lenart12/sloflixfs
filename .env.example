# Copy to .env and fill in the credentials. Every setting here is passed to sloflixfs; optional ones are
# shown commented out with their defaults. See the README's Configuration section.

# Credentials (required)
SLOFLIX_USER=
SLOFLIX_PASS=

# Crawler and cache
#SLOFLIX_REFRESH=12h
#SLOFLIX_REVALIDATE=168h
#SLOFLIX_PROBE_CACHE=500
#SLOFLIX_RATE=1
#SLOFLIX_CONCURRENCY=3

# Jellyfin scans: start a library scan when new titles are ready. Key from Dashboard > API Keys.
#SLOFLIX_JELLYFIN_URL=http://jellyfin:8096
#SLOFLIX_JELLYFIN_KEY=

# Testing: list only the newest N titles, e.g. 20 movies and 2 shows (0 = all)
#SLOFLIX_LIMIT_MOVIES=0
#SLOFLIX_LIMIT_SHOWS=0

# Host paths: the mount appears at $SLOFLIX_DIR/library
#SLOFLIX_DIR=/mnt/sloflix
